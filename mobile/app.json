{
  "expo": {
    "name": "AI Banking",
    "slug": "ai-banking-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#061428"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aibanking.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to authenticate quickly"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#061428"
      },
      "package": "com.aibanking.mobile"
    },
    "plugins": [],
    "entryPoint": "./index.js"
  }
}
