# Server
PORT=5001
NODE_ENV=development

# PostgreSQL / Supabase (connection string)
DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_banking

# JWT
JWT_SECRET=your_jwt_secret_here

# Supabase (for auth / storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Engine
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=dev-key-change-in-production

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
TWITTER_CONSUMER_KEY=your_twitter_consumer_key
TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret

# Email
EMAIL_USER=smartbankingpoweredbyai@gmail.com
EMAIL_PASS=your_email_app_password

# Paypack
PAYPACK_BASE_URL=https://payments.paypack.rw/api
PAYPACK_CLIENT_ID=your_paypack_client_id
PAYPACK_CLIENT_SECRET=your_paypack_client_secret
